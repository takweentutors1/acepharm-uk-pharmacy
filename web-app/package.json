{
  "name": "acepharm-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel dev",
    "dev:marketing": "pnpm --filter @acepharm/marketing dev",
    "dev:app": "pnpm --filter @acepharm/app dev",
    "dev:api": "pnpm --filter @acepharm/api dev",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "test": "pnpm --recursive --if-present test",
    "typecheck": "pnpm --recursive typecheck",
    "clean": "pnpm --recursive exec rm -rf node_modules dist .astro .next"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd",
      "@firebase/util",
      "protobufjs"
    ]
  },
  "packageManager": "pnpm@9.15.4"
}
