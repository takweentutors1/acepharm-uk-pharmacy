---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Cookie Policy — AcePharm"
  description="How AcePharm uses cookies and strictly privacy-preserving analytics."
>
  <section class="py-16 sm:py-24 bg-gradient-to-b from-primary-50/40 to-canvas border-b border-border-subtle text-center px-4">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-ink">
        Cookie Policy
      </h1>
      <p class="mt-4 text-xl text-primary font-semibold">How AcePharm uses cookies.</p>
    </div>
  </section>

  <section class="py-16 max-w-3xl mx-auto px-4 space-y-8 text-sm text-ink leading-relaxed">
    <div class="space-y-3">
      <h2 class="text-base font-bold text-ink uppercase tracking-wider">1. Essential Cookies</h2>
      <p class="text-ink-muted">Essential cookies maintain your secure authenticated session and preserve your UI preferences (such as confidence prompt settings and theme).</p>
    </div>

    <div class="space-y-3">
      <h2 class="text-base font-bold text-ink uppercase tracking-wider">2. Analytics Cookies</h2>
      <p class="text-ink-muted">We only initialize analytics tools (Google Analytics 4 & Cloudflare Web Analytics) after you provide explicit consent through our cookie banner.</p>
    </div>
  </section>
</BaseLayout>
