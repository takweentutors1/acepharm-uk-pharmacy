---
import '@acepharm/design-tokens/tokens.css';
import '../styles/global.css';
import { CookieConsentBanner, MobileNav } from '@acepharm/ui';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const {
  title = 'AcePharm — Created by pharmacists. Built for pharmacy students.',
  description = 'A revision platform designed exclusively for UK MPharm students, foundation trainees, and GPhC candidates.',
  canonicalUrl = Astro.url.href,
  ogImage = 'https://acepharm.co.uk/og-image.png',
  ogType = 'website',
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {/* Open Graph / Facebook / LinkedIn */}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="AcePharm" />
    <meta property="og:locale" content="en_GB" />

    {/* Twitter Cards */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    
    {/* Organization Structured Data (JSON-LD) for AEO/GEO */}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'AcePharm',
      url: 'https://acepharm.co.uk',
      logo: 'https://acepharm.co.uk/logo.png',
      description: 'Educational revision platform designed exclusively for UK pharmacy students, foundation trainees, and GPhC registration candidates.',
      sameAs: [],
      knowsAbout: [
        'Pharmacy Education',
        'GPhC Registration Assessment',
        'Clinical Pharmacology',
        'Pharmaceutical Calculations',
        'BNF Guidelines',
        'NICE Guidelines'
      ]
    })} />
  </head>
  <body class="bg-canvas text-ink font-sans antialiased min-h-screen flex flex-col selection:bg-indigo-wash selection:text-indigo">
    <header class="border-b border-border bg-surface/90 backdrop-blur-md sticky top-0 z-50 transition-all">
      <div class="max-w-container-max mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-indigo to-teal flex items-center justify-center text-white font-bold text-sm shadow-sm group-hover:opacity-90 transition-opacity">
            A
          </div>
          <span class="text-xl font-bold tracking-tight text-ink group-hover:text-indigo transition-colors">AcePharm</span>
        </a>
        
        {/* Desktop Grouped Navigation */}
        <nav class="hidden md:flex items-center gap-1 text-sm font-medium text-slate">
          <a href="/features" class={`px-3 py-2 rounded-btn hover:text-ink hover:bg-canvas transition-colors ${currentPath === '/features' ? 'text-indigo font-bold bg-indigo-wash' : ''}`}>Features</a>
          <a href="/question-bank" class={`px-3 py-2 rounded-btn hover:text-ink hover:bg-canvas transition-colors ${currentPath === '/question-bank' ? 'text-indigo font-bold bg-indigo-wash' : ''}`}>Question Bank</a>
          <a href="/ace" class={`px-3 py-2 rounded-btn hover:text-ink hover:bg-canvas transition-colors ${currentPath === '/ace' ? 'text-indigo font-bold bg-indigo-wash' : ''}`}>Ace AI Tutor</a>
          <a href="/pricing" class={`px-3 py-2 rounded-btn hover:text-ink hover:bg-canvas transition-colors ${currentPath === '/pricing' ? 'text-indigo font-bold bg-indigo-wash' : ''}`}>Pricing</a>
          
          {/* Resources & Guides Dropdown Group */}
          <div class="relative group">
            <button
              type="button"
              class="px-3 py-2 rounded-btn hover:text-ink hover:bg-canvas transition-colors flex items-center gap-1 text-slate font-medium"
            >
              <span>Resources</span>
              <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="absolute top-full left-0 mt-1 w-52 bg-surface border border-border rounded-xl shadow-xl p-1.5 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
              <a href="/blog" class="block px-3 py-2 text-xs font-semibold text-ink hover:bg-canvas rounded-lg">Revision Guides</a>
              <a href="/about" class="block px-3 py-2 text-xs text-slate hover:text-ink hover:bg-canvas rounded-lg">About AcePharm</a>
              <a href="/editorial-standards" class="block px-3 py-2 text-xs text-slate hover:text-ink hover:bg-canvas rounded-lg">Editorial Standards</a>
              <a href="/faq" class="block px-3 py-2 text-xs text-slate hover:text-ink hover:bg-canvas rounded-lg">Student FAQ</a>
              <a href="/contact" class="block px-3 py-2 text-xs text-slate hover:text-ink hover:bg-canvas rounded-lg">Contact Team</a>
            </div>
          </div>
        </nav>

        {/* Desktop Auth Actions & Mobile Hamburger */}
        <div class="flex items-center gap-3">
          <div class="hidden sm:flex items-center gap-2.5">
            <a
              href="https://acepharm-app.pages.dev/auth/login"
              class="text-xs font-semibold text-slate hover:text-ink px-3 py-2 rounded-btn border border-border hover:border-slate transition-colors"
            >
              Log in
            </a>
            <a
              href="https://acepharm-app.pages.dev/auth/register"
              class="text-xs font-semibold text-white bg-indigo hover:bg-indigo-deep px-3.5 py-2 rounded-btn shadow-xs transition-all"
            >
              Start revising free
            </a>
          </div>
          <MobileNav client:idle currentPath={currentPath} />
        </div>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-border bg-surface py-16 mt-20 text-sm text-slate">
      <div class="max-w-container-max mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-12">
          <div>
            <h4 class="font-bold text-ink text-xs uppercase tracking-wider mb-3">Product</h4>
            <ul class="space-y-1 text-xs">
              <li><a href="/features" class="inline-block py-1.5 hover:text-ink transition-colors">Features</a></li>
              <li><a href="/question-bank" class="inline-block py-1.5 hover:text-ink transition-colors">Question Bank</a></li>
              <li><a href="/ace" class="inline-block py-1.5 hover:text-ink transition-colors">Ace AI Tutor</a></li>
              <li><a href="/pricing" class="inline-block py-1.5 hover:text-ink transition-colors">Pricing</a></li>
            </ul>
          </div>
          <div>
            <h4 class="font-bold text-ink text-xs uppercase tracking-wider mb-3">Resources</h4>
            <ul class="space-y-1 text-xs">
              <li><a href="/blog" class="inline-block py-1.5 hover:text-ink transition-colors">Revision Guides</a></li>
              <li><a href="/faq" class="inline-block py-1.5 hover:text-ink transition-colors">FAQ</a></li>
              <li><a href="/editorial-standards" class="inline-block py-1.5 hover:text-ink transition-colors">Editorial Standards</a></li>
            </ul>
          </div>
          <div>
            <h4 class="font-bold text-ink text-xs uppercase tracking-wider mb-3">Company</h4>
            <ul class="space-y-1 text-xs">
              <li><a href="/about" class="inline-block py-1.5 hover:text-ink transition-colors">About Us</a></li>
              <li><a href="/contact" class="inline-block py-1.5 hover:text-ink transition-colors">Contact</a></li>
            </ul>
          </div>
          <div>
            <h4 class="font-bold text-ink text-xs uppercase tracking-wider mb-3">Legal</h4>
            <ul class="space-y-1 text-xs">
              <li><a href="/terms" class="inline-block py-1.5 hover:text-ink transition-colors">Terms</a></li>
              <li><a href="/privacy" class="inline-block py-1.5 hover:text-ink transition-colors">Privacy Policy</a></li>
              <li><a href="/cookie-policy" class="inline-block py-1.5 hover:text-ink transition-colors">Cookie Policy</a></li>
              <li><a href="/ai-use-policy" class="inline-block py-1.5 hover:text-ink transition-colors">AI Use Policy</a></li>
              <li><a href="/accessibility" class="inline-block py-1.5 hover:text-ink transition-colors">Accessibility Statement</a></li>
            </ul>
          </div>
        </div>

        <div class="border-t border-border pt-8 space-y-3">
          <p class="text-xs text-slate-light leading-relaxed">
            <strong>Independence disclaimer:</strong> AcePharm is an independent educational platform. It is not affiliated with or endorsed by the General Pharmaceutical Council, universities, NICE, the NHS or any other organisation unless explicitly stated.
          </p>
          <p class="text-xs text-slate-light leading-relaxed">
            <strong>Educational disclaimer:</strong> AcePharm is an educational resource. It does not provide patient-specific medical advice and does not replace official guidance, university teaching, professional supervision, clinical judgement or local policies.
          </p>
          <p class="text-xs text-slate-light pt-2">
            © {new Date().getFullYear()} AcePharm. All rights reserved.
          </p>
        </div>
      </div>
    </footer>

    <script>
      import { tracker } from '@acepharm/ui';
      // Initialize tracker on page load
      tracker.init({
        cloudflareWebAnalyticsToken: import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN,
      });
    </script>
    <CookieConsentBanner client:idle />
  </body>
</html>
