---
import '@acepharm/design-tokens/tokens.css';
import { CookieConsentBanner } from '@acepharm/ui';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'AcePharm — Created by pharmacists. Built for pharmacy students.',
  description = 'A revision platform designed exclusively for UK MPharm students, foundation trainees, and GPhC candidates.',
} = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    
    {/* Organization Structured Data (JSON-LD) for AEO/GEO */}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'AcePharm',
      url: 'https://acepharm.co.uk',
      logo: 'https://acepharm.co.uk/logo.png',
      description: 'Educational revision platform designed exclusively for UK pharmacy students, foundation trainees, and GPhC registration candidates.',
      sameAs: [],
      knowsAbout: [
        'Pharmacy Education',
        'GPhC Registration Assessment',
        'Clinical Pharmacology',
        'Pharmaceutical Calculations',
        'BNF Guidelines',
        'NICE Guidelines'
      ]
    })} />
  </head>
  <body class="bg-canvas text-ink font-sans antialiased min-h-screen flex flex-col">
    <header class="border-b border-border bg-surface sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
          <span class="text-2xl font-bold tracking-tight text-primary">AcePharm</span>
        </a>
        <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-ink-muted">
          <a href="/features" class="hover:text-ink transition-colors">Features</a>
          <a href="/question-bank" class="hover:text-ink transition-colors">Question Bank</a>
          <a href="/ace" class="hover:text-ink transition-colors">Ace</a>
          <a href="/pricing" class="hover:text-ink transition-colors">Pricing</a>
          <a href="/about" class="hover:text-ink transition-colors">About</a>
          <a href="/faq" class="hover:text-ink transition-colors">FAQ</a>
          <a href="/contact" class="hover:text-ink transition-colors">Contact</a>
        </nav>
        <div class="flex items-center gap-3">
          <a
            href="https://app.acepharm.co.uk/login"
            class="text-sm font-medium text-ink-muted hover:text-ink px-3 py-2"
          >
            Log in
          </a>
          <a
            href="https://app.acepharm.co.uk/register"
            class="inline-flex items-center justify-center rounded-xl bg-primary px-4 py-2 text-sm font-semibold text-white hover:bg-primary-hover transition-colors shadow-sm"
          >
            Start revising free
          </a>
        </div>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-border-subtle bg-white py-16 mt-20 text-sm text-ink-muted">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-12">
          <div>
            <h4 class="font-bold text-ink text-xs uppercase tracking-wider mb-3">Product</h4>
            <ul class="space-y-2 text-xs">
              <li><a href="/question-bank" class="hover:text-ink">Question Bank</a></li>
              <li><a href="/features" class="hover:text-ink">Progress & Analytics</a></li>
              <li><a href="/ace" class="hover:text-ink">Ace AI Tutor</a></li>
              <li><a href="/pricing" class="hover:text-ink">Pricing</a></li>
            </ul>
          </div>
          <div>
            <h4 class="font-bold text-ink text-xs uppercase tracking-wider mb-3">Resources</h4>
            <ul class="space-y-2 text-xs">
              <li><a href="/blog" class="hover:text-ink">Blog</a></li>
              <li><a href="/faq" class="hover:text-ink">Student FAQ</a></li>
              <li><a href="/contact" class="hover:text-ink">Help Centre</a></li>
            </ul>
          </div>
          <div>
            <h4 class="font-bold text-ink text-xs uppercase tracking-wider mb-3">Company</h4>
            <ul class="space-y-2 text-xs">
              <li><a href="/about" class="hover:text-ink">About AcePharm</a></li>
              <li><a href="/editorial-standards" class="hover:text-ink">Editorial Standards</a></li>
              <li><a href="/contact" class="hover:text-ink">Contact</a></li>
            </ul>
          </div>
          <div>
            <h4 class="font-bold text-ink text-xs uppercase tracking-wider mb-3">Legal</h4>
            <ul class="space-y-2 text-xs">
              <li><a href="/terms" class="hover:text-ink">Terms</a></li>
              <li><a href="/privacy" class="hover:text-ink">Privacy Policy</a></li>
              <li><a href="/cookie-policy" class="hover:text-ink">Cookie Policy</a></li>
              <li><a href="/ai-use-policy" class="hover:text-ink">AI Use Policy</a></li>
              <li><a href="/accessibility" class="hover:text-ink">Accessibility Statement</a></li>
            </ul>
          </div>
        </div>

        <div class="border-t border-border-subtle pt-8 space-y-3">
          <p class="text-xs text-ink-subtle leading-relaxed">
            <strong>Independence disclaimer:</strong> AcePharm is an independent educational platform. It is not affiliated with or endorsed by the General Pharmaceutical Council, universities, NICE, the NHS or any other organisation unless explicitly stated.
          </p>
          <p class="text-xs text-ink-subtle leading-relaxed">
            <strong>Educational disclaimer:</strong> AcePharm is an educational resource. It does not provide patient-specific medical advice and does not replace official guidance, university teaching, professional supervision, clinical judgement or local policies.
          </p>
          <p class="text-xs text-ink-subtle pt-2">
            © {new Date().getFullYear()} AcePharm. All rights reserved.
          </p>
        </div>
      </div>
    </footer>

    <script>
      import { tracker } from '@acepharm/ui';
      // Initialize tracker on page load
      tracker.init({
        cloudflareWebAnalyticsToken: import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN,
      });
    </script>
    <CookieConsentBanner client:idle />
  </body>
</html>
