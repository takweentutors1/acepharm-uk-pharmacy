---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ContactForm } from '@acepharm/ui';
---

<BaseLayout
  title="Contact Us — AcePharm"
  description="How can we help? Ask about your account, report a content concern, suggest a feature or speak to the AcePharm team."
>
  <section class="py-16 sm:py-24 bg-gradient-to-b from-indigo-wash/50 via-canvas to-canvas border-b border-border text-center px-4">
    <div class="max-w-4xl mx-auto">
      <div class="inline-block mb-4">
        <span class="px-3.5 py-1 rounded-full bg-indigo-wash text-indigo text-xs font-semibold uppercase tracking-wider border border-indigo-200">
          Support & Inquiries
        </span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-ink">
        How can we help?
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-slate max-w-2xl mx-auto leading-relaxed">
        Ask about your account, report a content concern, suggest a feature or speak to the AcePharm team.
      </p>
    </div>
  </section>

  <section class="py-20 max-w-2xl mx-auto px-4">
    <ContactForm client:visible />
  </section>
</BaseLayout>
