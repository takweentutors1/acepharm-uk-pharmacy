---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Button } from '@acepharm/ui';

const { slug } = Astro.params;

// Fetch dynamically from API worker / fallback default
let post = null;
const API_URL = import.meta.env.PUBLIC_API_URL || 'https://acepharm-api.takweencentreuk.workers.dev';

try {
  const res = await fetch(`${API_URL}/api/v1/blog/${slug}`);
  if (res.ok) {
    const data = await res.json();
    post = data.post;
  }
} catch (err) {
  console.warn('Failed fetching post from API, using SSR fallback:', err);
}

if (!post) {
  return Astro.redirect('/blog');
}

// Convert markdown to clean HTML paragraphs
const renderMarkdown = (md: string) => {
  return md
    .replace(/^### (.*$)/gim, '<h3 class="text-lg font-bold text-ink mt-6 mb-2">$1</h3>')
    .replace(/^## (.*$)/gim, '<h2 class="text-xl font-bold text-ink mt-8 mb-3 pb-2 border-b border-border-subtle">$1</h2>')
    .replace(/^# (.*$)/gim, '<h1 class="text-2xl font-bold text-ink mt-8 mb-4">$1</h1>')
    .replace(/\*\*(.*)\*\*/gim, '<strong>$1</strong>')
    .replace(/```([\s\S]*?)```/gim, '<pre class="bg-surface-raised p-4 rounded-xl border border-border text-xs font-mono my-4 overflow-x-auto"><code>$1</code></pre>')
    .replace(/\n\n/gim, '</p><p class="mt-4 leading-relaxed text-sm text-ink-muted">')
    .replace(/^- (.*$)/gim, '<li class="ml-4 list-disc text-sm text-ink-muted">$1</li>');
};

const tags = post.tagsJson ? JSON.parse(post.tagsJson) : [];
const dateStr = post.publishedAt ? new Date(post.publishedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : '';
---

<BaseLayout
  title={`${post.title} — AcePharm Blog`}
  description={post.summary}
>
  {/* Article JSON-LD Structured Data for AEO/GEO */}
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: post.title,
    description: post.summary,
    author: {
      '@type': 'Organization',
      name: 'AcePharm Clinical Editorial Team'
    },
    publisher: {
      '@type': 'Organization',
      name: 'AcePharm',
      url: 'https://acepharm.co.uk',
      logo: 'https://acepharm.co.uk/logo.png'
    },
    datePublished: post.publishedAt || new Date().toISOString(),
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': `https://acepharm.co.uk/blog/${slug}`
    }
  })} />

  <article class="max-w-3xl mx-auto px-4 py-16">
    <a href="/blog" class="inline-flex items-center gap-1 text-xs font-bold text-primary mb-8 hover:underline">
      ← Back to revision guides
    </a>

    <header class="space-y-4 mb-10 pb-8 border-b border-border-subtle">
      <div class="flex flex-wrap gap-2 items-center">
        {tags.map((tag: string) => (
          <span class="px-3 py-0.5 rounded-full bg-primary-50 text-primary text-xs font-bold">
            {tag}
          </span>
        ))}
        {dateStr && <span class="text-xs text-ink-subtle ml-2">{dateStr}</span>}
        <span class="text-xs text-ink-subtle">· {post.readingTimeMinutes || 4} min read</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-ink">
        {post.title}
      </h1>

      <p class="text-base text-ink-muted italic border-l-4 border-primary pl-4 py-1 bg-surface-raised/40 rounded-r-lg">
        {post.summary}
      </p>
    </header>

    <div class="prose prose-sm max-w-none text-ink leading-relaxed" set:html={`<p class="text-sm text-ink-muted leading-relaxed">${renderMarkdown(post.contentMarkdown)}</p>`} />

    <footer class="mt-16 pt-8 border-t border-border-subtle flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <p class="text-xs font-bold text-ink">AcePharm Clinical Editorial Team</p>
        <p class="text-xs text-ink-subtle">Reviewed against current UK BNF & NICE practice guidance.</p>
      </div>
      <a href="https://acepharm-app.pages.dev/auth/register">
        <Button variant="primary" size="lg">Start revising free</Button>
      </a>
    </footer>
  </article>
</BaseLayout>
