---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Button, MarkdownRenderer } from '@acepharm/ui';

const { slug } = Astro.params;

// Fetch dynamically from API worker / fallback default
let post = null;
const API_URL = import.meta.env.PUBLIC_API_URL || 'https://acepharm-api.takweencentreuk.workers.dev';

try {
  const res = await fetch(`${API_URL}/api/v1/blog/${slug}`);
  if (res.ok) {
    const data = await res.json();
    post = data.post;
  }
} catch (err) {
  console.warn('Failed fetching post from API, using SSR fallback:', err);
}

if (!post) {
  return Astro.redirect('/blog');
}

const tags = post.tagsJson ? JSON.parse(post.tagsJson) : [];
const dateStr = post.publishedAt ? new Date(post.publishedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : '';
---

<BaseLayout
  title={`${post.title} — AcePharm Blog`}
  description={post.summary}
>
  {/* Article JSON-LD Structured Data for AEO/GEO */}
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: post.title,
    description: post.summary,
    author: {
      '@type': 'Organization',
      name: 'AcePharm Clinical Editorial Team'
    },
    publisher: {
      '@type': 'Organization',
      name: 'AcePharm',
      url: 'https://acepharmexams.co.uk',
      logo: 'https://acepharmexams.co.uk/logo.png'
    },
    datePublished: post.publishedAt || new Date().toISOString(),
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': `https://acepharmexams.co.uk/blog/${slug}`
    }
  })} />

  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
    <a href="/blog" class="inline-flex items-center gap-1.5 text-xs font-bold text-indigo hover:text-indigo-deep mb-8 transition-colors">
      <span>←</span>
      <span>Back to revision guides</span>
    </a>

    <header class="space-y-4 mb-10 pb-8 border-b border-border">
      <div class="flex flex-wrap gap-2 items-center">
        {tags.map((tag: string) => (
          <span class="px-3 py-1 rounded-full bg-indigo/10 text-indigo text-xs font-bold">
            {tag}
          </span>
        ))}
        {dateStr && <span class="text-xs text-slate ml-2">{dateStr}</span>}
        <span class="text-xs text-slate">· {post.readingTimeMinutes || 4} min read</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-ink leading-tight">
        {post.title}
      </h1>

      <p class="text-base sm:text-lg text-slate italic border-l-4 border-indigo pl-4 py-2 bg-canvas rounded-r-lg">
        {post.summary}
      </p>
    </header>

    {/* Rich UI Markdown Content Rendering with High-Yield Tables & Code Styling */}
    <div class="blog-content-wrapper my-8">
      <MarkdownRenderer content={post.contentMarkdown} />
    </div>

    <footer class="mt-16 pt-8 border-t border-border-subtle flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <p class="text-xs font-bold text-ink">AcePharm Clinical Editorial Team</p>
        <p class="text-xs text-ink-subtle">Reviewed against current UK BNF & NICE practice guidance.</p>
      </div>
      <a href="https://app.acepharmexams.co.uk/auth/register">
        <Button variant="primary" size="lg">Start revising free</Button>
      </a>
    </footer>
  </article>
</BaseLayout>
