---
import BaseLayout from '../layouts/BaseLayout.astro';
import { TopicFilter } from '@acepharm/ui';

// Fetch dynamically from D1 API worker with fallback
const API_URL = import.meta.env.PUBLIC_API_URL || 'https://acepharm-api.takweencentreuk.workers.dev';
let articles = [];

const DEFAULT_ARTICLES = [
  {
    slug: 'gphc-calculations-essential-methods',
    title: 'GPhC Calculations: 5 High-Yield Pitfalls and Step-by-Step Fixes',
    category: 'Calculations',
    date: '18 September 2026',
    readTime: '6 min read',
    excerpt: 'Mastering displacement volumes, paediatric mg/kg body weight scaling, and infusion rate conversions with diagnostic precision.',
  },
  {
    slug: 'asthma-bts-sign-vs-nice-guideline-comparison',
    title: 'Asthma Inhaler Stepping: BTS/SIGN vs NICE Guidance Compared',
    category: 'Clinical Revision',
    date: '12 September 2026',
    readTime: '8 min read',
    excerpt: 'Understanding the practical differences in adult asthma management steps, MART regimens, and preventer counselling points.',
  },
  {
    slug: 'mpharm-active-recall-spaced-repetition',
    title: 'How to Structure Spaced Repetition for MPharm Final Exams',
    category: 'MPharm Study',
    date: '5 September 2026',
    readTime: '5 min read',
    excerpt: 'Why raw percentage scores mislead learners, and how calibrating confidence against first-attempt accuracy eliminates clinical blind spots.',
  },
  {
    slug: 'high-risk-medicines-monitoring-guidelines',
    title: 'High-Risk Medicines: Key Monitoring Parameters and Toxicities',
    category: 'Registration Assessment',
    date: '28 August 2026',
    readTime: '10 min read',
    excerpt: 'Therapeutic drug monitoring protocols, baseline tests, and critical red-flag symptoms for Lithium, Methotrexate, Amiodarone, and Digoxin.',
  },
  {
    slug: 'controlled-drugs-prescription-requirements-uk',
    title: 'Controlled Drugs Schedule Breakdown and Prescription Legality',
    category: 'Clinical Revision',
    date: '20 August 2026',
    readTime: '7 min read',
    excerpt: 'A definitive guide to CD schedules 1 through 5, requisition requirements, maximum quantities, and instalment prescription rules.',
  },
];

try {
  const res = await fetch(`${API_URL}/api/v1/blog`);
  if (res.ok) {
    const data = await res.json();
    if (data.posts && data.posts.length > 0) {
      articles = data.posts.map((p: any) => {
        const tags = p.tagsJson ? JSON.parse(p.tagsJson) : [];
        const primaryCat = tags[0] || 'Clinical Revision';
        return {
          slug: p.slug,
          title: p.title,
          category: primaryCat,
          date: p.publishedAt ? new Date(p.publishedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : 'Recent',
          readTime: `${p.readingTimeMinutes || 5} min read`,
          excerpt: p.summary,
        };
      });
    }
  }
} catch (e) {
  console.warn('Could not fetch live blog posts from API:', e);
}

if (articles.length === 0) {
  articles = DEFAULT_ARTICLES;
}

const CATEGORIES = [
  'MPharm Study',
  'Registration Assessment',
  'Calculations',
  'Clinical Revision',
];
---

<BaseLayout
  title="Revision Guides & Clinical Notes — AcePharm"
  description="Pharmacy revision, explained clearly. High-yield clinical revision guides, calculation walkthroughs, and evidence-led study strategies."
>
  {/* CollectionPage JSON-LD Structured Data for AEO/GEO */}
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'AcePharm Pharmacy Revision Guides & Clinical Notes',
    description: 'Evidence-led UK pharmacy revision articles, clinical therapeutics reviews, and calculation walkthroughs.',
    url: 'https://acepharm.co.uk/blog',
    hasPart: articles.map((a) => ({
      '@type': 'Article',
      headline: a.title,
      description: a.excerpt,
      url: `https://acepharm.co.uk/blog/${a.slug}`,
      datePublished: '2026-09-01',
      author: {
        '@type': 'Organization',
        name: 'AcePharm Clinical Editorial Team'
      }
    }))
  })} />

  <section class="py-16 sm:py-24 bg-gradient-to-b from-indigo-wash/50 via-canvas to-canvas border-b border-border text-center px-4">
    <div class="max-w-4xl mx-auto">
      <div class="inline-block mb-4">
        <span class="px-3.5 py-1 rounded-full bg-indigo-wash text-indigo text-xs font-semibold uppercase tracking-wider border border-indigo-200">
          Clinical Learning Hub
        </span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-ink">
        Pharmacy revision, explained clearly.
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-slate max-w-2xl mx-auto leading-relaxed">
        High-yield clinical revision guides, calculation walkthroughs, and evidence-led study strategies designed for UK pharmacy learners.
      </p>
    </div>
  </section>

  <section class="py-20 max-w-5xl mx-auto px-4">
    {/* Interactive Topic Filter Island */}
    <TopicFilter client:visible categories={CATEGORIES} articles={articles} />
  </section>
</BaseLayout>
