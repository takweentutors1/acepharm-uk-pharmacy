---
import BaseLayout from '../layouts/BaseLayout.astro';
import { TopicFilter } from '@acepharm/ui';

// Fetch dynamically from D1 API worker with fallback
const API_URL = import.meta.env.PUBLIC_API_URL || 'https://api.acepharmexams.co.uk';
let articles: Array<{
  slug: string;
  title: string;
  category: string;
  date: string;
  readTime: string;
  excerpt: string;
}> = [];

const DEFAULT_ARTICLES = [
  {
    slug: 'gphc-calculations-essential-methods',
    title: 'GPhC Calculations: 10 High-Yield Pitfalls, Infusion Formulas, and Paediatric Dosing',
    category: 'Calculations',
    date: '18 September 2026',
    readTime: '12 min read',
    excerpt: 'The definitive Paper 1 blueprint: displacement volumes, paediatric mg/kg body weight scaling, infusion rate conversions, and molecular weight shifts.',
  },
  {
    slug: 'asthma-bts-sign-vs-nice-guideline-comparison',
    title: 'NICE CKS vs BNF 87/88: Mastering the High-Weighting Therapeutic Clinical Scenarios',
    category: 'Clinical Revision',
    date: '12 September 2026',
    readTime: '11 min read',
    excerpt: 'Step-by-step decision algorithms for Hypertension (NG136), Asthma (BTS/SIGN vs NICE NG80), and Type 2 Diabetes (NG28) for GPhC Paper 2.',
  },
  {
    slug: 'high-risk-medicines-monitoring-guidelines',
    title: 'High-Risk Medicines in UK Pharmacy: Monitoring, Toxicities, and MHRA Alerts',
    category: 'Registration Assessment',
    date: '28 August 2026',
    readTime: '10 min read',
    excerpt: 'Complete clinical safety guide for Lithium, Methotrexate, Amiodarone, Digoxin, and Gentamicin. Target serum ranges, sampling times, and red flags.',
  },
  {
    slug: 'passmed-vs-quesmed-vs-acepharm-uk-pharmacy-comparison',
    title: 'Passmed vs Quesmed vs AcePharm: Choosing the Best UK Revision Platform (2026)',
    category: 'MPharm Study',
    date: '1 September 2026',
    readTime: '9 min read',
    excerpt: 'A deep comparative review of UK healthcare question banks: why medical question banks fall short for pharmacy students and how AcePharm fills the gap.',
  },
  {
    slug: 'oriel-pharmacy-sjt-foundation-training-guide',
    title: 'Oriel Pharmacy Recruitment: Master the Situational Judgement Test (SJT) and Foundation Posts',
    category: 'Registration Assessment',
    date: '20 August 2026',
    readTime: '10 min read',
    excerpt: 'A step-by-step masterclass on scoring in the top decile for Oriel pharmacy SJT, ranking NHS and community placements, and handling ethical dilemmas.',
  },
];

try {
  const res = await fetch(`${API_URL}/api/v1/blog`);
  if (res.ok) {
    const data = await res.json();
    if (data.posts && data.posts.length > 0) {
      articles = data.posts.map((p: any) => {
        const tags = p.tagsJson ? JSON.parse(p.tagsJson) : [];
        const primaryCat = tags[0] || 'Clinical Revision';
        return {
          slug: p.slug,
          title: p.title,
          category: primaryCat,
          date: p.publishedAt ? new Date(p.publishedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : 'Recent',
          readTime: `${p.readingTimeMinutes || 5} min read`,
          excerpt: p.summary,
        };
      });
    }
  }
} catch (e) {
  console.warn('Could not fetch live blog posts from API:', e);
}

if (articles.length === 0) {
  articles = DEFAULT_ARTICLES;
}

const CATEGORIES = [
  'MPharm Study',
  'Registration Assessment',
  'Calculations',
  'Clinical Revision',
];
---

<BaseLayout
  title="Revision Guides & Clinical Notes — AcePharm"
  description="Pharmacy revision, explained clearly. High-yield clinical revision guides, calculation walkthroughs, and evidence-led study strategies."
>
  {/* CollectionPage JSON-LD Structured Data for AEO/GEO */}
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'AcePharm Pharmacy Revision Guides & Clinical Notes',
    description: 'High-yield clinical revision guides, GPhC calculation walkthroughs, and evidence-led study strategies.',
    url: 'https://acepharmexams.co.uk/blog',
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: articles.map((a, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `https://acepharmexams.co.uk/blog/${a.slug}`,
        name: a.title,
      }))
    }
  })} />

  <section class="py-16 sm:py-24 bg-gradient-to-b from-indigo-wash/50 via-canvas to-canvas border-b border-border text-center px-4">
    <div class="max-w-4xl mx-auto">
      <div class="inline-block mb-4">
        <span class="px-3.5 py-1 rounded-full bg-indigo-wash text-indigo text-xs font-semibold uppercase tracking-wider border border-indigo-200">
          Clinical Learning Hub
        </span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-ink">
        Pharmacy revision, explained clearly.
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-slate max-w-2xl mx-auto leading-relaxed">
        High-yield clinical revision guides, calculation walkthroughs, and evidence-led study strategies designed for UK pharmacy learners.
      </p>
    </div>
  </section>

  <section class="py-20 max-w-5xl mx-auto px-4">
    {/* Interactive Topic Filter Island */}
    <TopicFilter client:visible categories={CATEGORIES} articles={articles} />
  </section>
</BaseLayout>
