---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FaqAccordion } from '@acepharm/ui';

const FAQ_GROUPS = [
  {
    category: 'Product & Question Bank',
    items: [
      {
        question: 'What year of the MPharm is AcePharm for?',
        answer: 'AcePharm is built specifically around MPharm years 2 to 4, foundation training, and GPhC registration candidates. Content is cleanly categorised by topic and clinical domain so you can align sessions directly with your current university module or revision schedule.',
      },
      {
        question: 'Is AcePharm only for the Registration Assessment?',
        answer: 'No. AcePharm is designed to support pharmacy students throughout undergraduate degree modules (therapeutics, pharmacology, pharmaceutics, and calculations) and continuously through foundation training into the registration assessment.',
      },
      {
        question: 'How many questions are in the bank?',
        answer: 'The question bank is continuously expanding across all major BNF clinical chapters and high-weighting calculations. You can see exact question counts broken down by topic and difficulty level in the question bank browser prior to starting a session.',
      },
      {
        question: 'Can I choose which topics and formats to practise?',
        answer: 'Yes. You have complete control over session creation. Choose specific topics (e.g. Cardiovascular, Respiratory, Calculations), question types (Single Best Answer, Extended Matching Questions), time modes (untimed study mode with immediate rationales or timed exam simulation), and difficulty levels.',
      },
    ],
  },
  {
    category: 'Clinical Quality & AI Tutor (Ace)',
    items: [
      {
        question: 'Who writes and reviews the questions?',
        answer: 'All questions and clinical rationales are authored by qualified UK clinical pharmacists and subject matter experts. Every item passes through our triple-review workflow (clinical accuracy, educational design, and editorial clarity) before publication.',
      },
      {
        question: 'Are the clinical rationales referenced?',
        answer: 'Yes. Every question rationale links directly to authoritative UK reference sources including the BNF, NICE guidelines, MHRA drug safety updates, and NHS national frameworks with clearly stated review dates.',
      },
      {
        question: 'Does Ace (AI Tutor) replace official guidance or give medical advice?',
        answer: 'No. Ace is an educational tutor strictly grounded in AcePharm’s reviewed content and cited UK clinical guidelines. It does not provide patient-specific clinical advice and is never a substitute for the BNF, official guidance, or your own professional judgement.',
      },
    ],
  },
  {
    category: 'Subscriptions & Account Access',
    items: [
      {
        question: 'Is the Explorer plan completely free?',
        answer: 'Yes. The Explorer plan provides 30 questions every month, resetting on your signup anniversary. It is permanently free—not a timed trial—and requires no debit or credit card to join.',
      },
      {
        question: 'Can I cancel my subscription at any time?',
        answer: 'Yes. You can cancel your Monthly or Yearly subscription online at any time in one click from your account settings. You will retain full Pro access until the end of your paid billing period.',
      },
      {
        question: 'What happens to my study history if I cancel Pro?',
        answer: 'Your study history, first-attempt accuracy calibration data, question bookmarks, and personal notes remain safely preserved in your account forever. If you decide to reactivate Pro in the future, your revision analytics will pick up right where you left off.',
      },
      {
        question: 'Can I use AcePharm on mobile and tablet?',
        answer: 'Yes. AcePharm is engineered from the ground up as a responsive, mobile-first web application. You can revise seamlessly across your phone, tablet, and desktop without installing heavy native apps.',
      },
    ],
  },
];
---

<BaseLayout
  title="FAQ — Frequently Asked Questions — AcePharm"
  description="Frequently asked questions about AcePharm question bank, content review, subscriptions and technical support."
>
  {/* FAQPage JSON-LD Structured Data for AEO/GEO */}
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQ_GROUPS.flatMap((group) => group.items).map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      }
    }))
  })} />

  <section class="py-16 sm:py-24 bg-gradient-to-b from-indigo-wash/50 via-canvas to-canvas border-b border-border text-center px-4">
    <div class="max-w-4xl mx-auto">
      <div class="inline-block mb-4">
        <span class="px-3.5 py-1 rounded-full bg-indigo-wash text-indigo text-xs font-semibold uppercase tracking-wider border border-indigo-200">
          Support & Clarity
        </span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-ink">
        Frequently Asked Questions
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-slate max-w-2xl mx-auto leading-relaxed">
        Everything you need to know about the question bank, clinical reviews, AI tutoring, and flexible plans.
      </p>
    </div>
  </section>

  <section class="py-20 max-w-4xl mx-auto px-4">
    {/* Interactive Accordion Island */}
    <FaqAccordion client:visible groups={FAQ_GROUPS} />

    {/* Contact CTA */}
    <div class="mt-20 text-center bg-surface border border-border rounded-card p-8 shadow-xs">
      <h3 class="text-base font-bold text-ink">Have a question not answered here?</h3>
      <p class="text-xs text-slate mt-2">
        Our clinical team is always available to help pharmacy students with questions, feedback, or guidance.
      </p>
      <div class="mt-6">
        <a
          href="/contact"
          class="inline-flex items-center justify-center rounded-btn bg-indigo px-5 py-2.5 text-sm font-semibold text-white hover:bg-indigo-deep transition-all shadow-sm"
        >
          Contact the team
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
