---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PricingToggle, Card } from '@acepharm/ui';
---

<BaseLayout
  title="Pricing — AcePharm"
  description="Simple pricing. Full access when you need it. No complicated bundles and no hidden feature tiers."
>
  {/* Product & Offer JSON-LD Structured Data for AEO/GEO */}
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'AcePharm Revision Platform',
    description: 'Comprehensive pharmacy revision platform with clinical questions, calculations, and AI tutoring.',
    brand: {
      '@type': 'Brand',
      name: 'AcePharm'
    },
    offers: [
      {
        '@type': 'Offer',
        name: 'AcePharm Monthly',
        price: '4.99',
        priceCurrency: 'GBP',
        availability: 'https://schema.org/InStock',
        url: 'https://acepharm.co.uk/pricing',
        priceValidUntil: '2027-12-31'
      },
      {
        '@type': 'Offer',
        name: 'AcePharm Yearly',
        price: '49.99',
        priceCurrency: 'GBP',
        availability: 'https://schema.org/InStock',
        url: 'https://acepharm.co.uk/pricing',
        priceValidUntil: '2027-12-31'
      }
    ]
  })} />

  <section class="py-16 sm:py-24 bg-gradient-to-b from-indigo-wash/50 via-canvas to-canvas border-b border-border text-center px-4">
    <div class="max-w-4xl mx-auto">
      <div class="inline-block mb-4">
        <span class="px-3.5 py-1 rounded-full bg-indigo-wash text-indigo text-xs font-semibold uppercase tracking-wider border border-indigo-200">
          Transparent Revision Pricing
        </span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-ink">
        Simple pricing. Full access when you need it.
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-slate max-w-2xl mx-auto leading-relaxed">
        Premium revision without premium-student pricing. No complicated bundles and no hidden feature tiers.
      </p>
    </div>
  </section>

  <section class="py-20 max-w-5xl mx-auto px-4">
    {/* Interactive Island for Pricing */}
    <PricingToggle client:visible />

    {/* University & Institutional Licensing Section */}
    <div class="mt-24 bg-surface border border-border rounded-card p-8 sm:p-12 text-center max-w-3xl mx-auto shadow-xs">
      <h2 class="text-2xl font-bold text-ink">University & Cohort Access</h2>
      <p class="mt-4 text-sm text-slate leading-relaxed">
        Are you an MPharm course leader, tutor, or NHS training provider? We provide institution-wide cohort licensing, curriculum mapping support, and custom diagnostic cohorts.
      </p>
      <div class="mt-8">
        <a
          href="/contact?subject=institutional"
          class="inline-flex items-center justify-center rounded-btn bg-surface border border-border px-6 py-3 text-sm font-semibold text-ink hover:border-indigo hover:text-indigo transition-all shadow-xs"
        >
          Enquire about university licensing →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
