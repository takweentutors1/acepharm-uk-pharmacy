---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Button, Card } from '@acepharm/ui';
---

<BaseLayout
  title="Features — AcePharm"
  description="Everything you need for more focused pharmacy revision. Practise questions, understand difficult topics, follow your progress and receive a clear recommendation for what to do next."
>
  {/* WebPage & Educational Tool Structured Data */}
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'AcePharm Revision Platform Features',
    description: 'Explore the key features of AcePharm: clinical question engine, 4-stage rationales, dual-store analytics, and Ace AI tutor.',
    url: 'https://acepharm.co.uk/features'
  })} />

  <section class="py-16 sm:py-24 bg-gradient-to-b from-indigo-wash/50 via-canvas to-canvas border-b border-border text-center px-4">
    <div class="max-w-4xl mx-auto">
      <div class="inline-block mb-4">
        <span class="px-3.5 py-1 rounded-full bg-indigo-wash text-indigo text-xs font-semibold uppercase tracking-wider border border-indigo-200">
          Platform Capabilities
        </span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-ink">
        Everything you need for more focused pharmacy revision.
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-slate max-w-2xl mx-auto leading-relaxed">
        Practise questions, understand difficult topics, follow your progress and receive a clear recommendation for what to do next.
      </p>
      <div class="mt-8">
        <a href="https://app.acepharm.co.uk/register">
          <Button size="lg" variant="primary">Start revising free</Button>
        </a>
      </div>
    </div>
  </section>

  <section class="py-20 max-w-5xl mx-auto px-4 space-y-20">
    {/* Feature 1 */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
      <div class="space-y-4">
        <span class="text-xs font-bold uppercase tracking-wider text-indigo">Question Experience</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-ink">Questions designed to teach, not merely test.</h2>
        <p class="text-sm text-slate leading-relaxed">
          Single best answer scenarios and clinical calculations written to match modern GPhC assessment frameworks. Rate your confidence before submitting to highlight uncalibrated knowledge.
        </p>
      </div>
      <Card className="p-6 bg-surface border border-border rounded-card shadow-xs space-y-3">
        <div class="p-3 bg-canvas border border-border/50 rounded-btn text-xs text-slate font-medium">Pre-submission confidence rating (1–3)</div>
        <div class="p-3 bg-canvas border border-border/50 rounded-btn text-xs text-slate font-medium">Border & tint option selection (no premature spoilers)</div>
        <div class="p-3 bg-canvas border border-border/50 rounded-btn text-xs text-slate font-medium">Keyboard shortcuts (A–E, 1–3, Enter, Space)</div>
      </Card>
    </div>

    {/* Feature 2 */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
      <Card className="p-6 bg-surface border border-border rounded-card shadow-xs space-y-3 order-2 md:order-1">
        <div class="p-3 bg-teal-light text-teal border border-teal/20 rounded-btn text-xs font-medium">Stage 1: Concise Takeaway Principle</div>
        <div class="p-3 bg-canvas border border-border/50 rounded-btn text-xs text-slate font-medium">Stage 2: Comprehensive Clinical Rationale</div>
        <div class="p-3 bg-canvas border border-border/50 rounded-btn text-xs text-slate font-medium">Stage 3: Distractor Analysis (Every Option Explained)</div>
        <div class="p-3 bg-canvas border border-border/50 rounded-btn text-xs text-slate font-medium">Stage 4: Verified BNF & NICE Guideline Links</div>
      </Card>
      <div class="space-y-4 order-1 md:order-2">
        <span class="text-xs font-bold uppercase tracking-wider text-indigo">Explanation Quality</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-ink">Understand the answer properly.</h2>
        <p class="text-sm text-slate leading-relaxed">
          No lazy one-line feedback. Every question features a structured 4-stage explanation with rationales for all incorrect options, so you know exactly why the right answer is right and the wrong answers are wrong.
        </p>
      </div>
    </div>

    {/* Feature 3 */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
      <div class="space-y-4">
        <span class="text-xs font-bold uppercase tracking-wider text-indigo">Progress & Calibration</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-ink">See more than a percentage.</h2>
        <p class="text-sm text-slate leading-relaxed">
          Isolated first-attempt analytics ensure repeat practice tests never inflate your true readiness. Identify blind spots where high confidence resulted in incorrect answers.
        </p>
      </div>
      <Card className="p-6 bg-surface border border-border rounded-card shadow-xs space-y-3">
        <div class="p-3 bg-canvas border border-border/50 rounded-btn text-xs text-slate font-medium">Isolated first-attempt accuracy vs practice recall</div>
        <div class="p-3 bg-canvas border border-border/50 rounded-btn text-xs text-slate font-medium">Calibration matrix (High confidence vs accuracy)</div>
        <div class="p-3 bg-canvas border border-border/50 rounded-btn text-xs text-slate font-medium">Curriculum coverage by BNF chapter & weighting</div>
      </Card>
    </div>

    {/* Bottom CTA */}
    <div class="text-center pt-8 border-t border-border">
      <a href="https://app.acepharm.co.uk/register">
        <Button size="lg" variant="primary">Start revising free</Button>
      </a>
    </div>
  </section>
</BaseLayout>
